rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@admin\\.bitsgotlatent\\.com'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public Contestant Roster
    match /contestants/{contestantId} {
      allow read: if isValidId(contestantId);
      allow write: if isAdmin();
    }

    // Micro Influencers
    match /microInfluencers/{influencerId} {
      allow read: if isValidId(influencerId);
      allow write: if isAdmin();
    }

    // Confidential Panel Scores (Panel cannot see contestantSubmissions, public cannot see until revealed)
    match /panelScores/{contestantId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Confidential Contestant Submissions (Contestant can create/update only if unlocked and matching their access token)
    match /contestantSubmissions/{contestantId} {
      // Secret from panel!
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == contestantId);
      allow list: if isAdmin(); // Strictly restricted: panel and public CANNOT query or list predictions
      allow create: if isValidId(contestantId) && 
                    request.resource.data.contestantId == contestantId &&
                    request.resource.data.predictedScore is number &&
                    request.resource.data.predictedScore >= 0 &&
                    request.resource.data.predictedScore <= 100 &&
                    request.resource.data.isLocked is bool;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Live Show State
    match /showState/{stateId} {
      allow read: if stateId == 'current';
      allow write: if isAdmin();
    }

    // Presentation Events
    match /presentationEvents/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // Authorized Users
    match /authorizedUsers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
